---
import { STORE, PRODUCTS } from '../data/site.js';
const ext = STORE.live ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<header class="nav" data-nav>
  <div class="nav__pill">
    <a href="/" class="nav__logo" aria-label="Auvra home">
      <img src="/brand/auvra-logo-carbon.svg" alt="Auvra" width="112" height="32" />
    </a>
    <div class="nav__actions">
      <a class="nav__btn" href={STORE.appStore} {...ext} aria-label="Download on the App Store">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.4.8 2.3-1.3 3.1-2.5c1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.7-4.1zM13.9 5c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z"/></svg>
      </a>
      <a class="nav__btn" href={STORE.googlePlay} {...ext} aria-label="Get it on Google Play">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M3.6 1.8c-.3.3-.5.8-.5 1.4v17.6c0 .6.2 1.1.5 1.4l9.8-10.2zM16.7 15.3 13.4 12l3.3-3.3 3.9 2.2c1.1.6 1.1 1.6 0 2.2zM16.7 15.3 13.4 12l-9.8 10.2c.4.4 1 .4 1.7 0zM16.7 8.7 5.3 2c-.7-.4-1.3-.4-1.7 0L13.4 12z"/></svg>
      </a>
      <button class="nav__btn nav__menu" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Open menu" data-nav-toggle>
        <span class="burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="nav__panel" id="nav-panel" hidden data-nav-panel>
    <nav aria-label="Main">
      <ul class="nav__list">
        <li><a href="/#lens-ai" data-nav-link>Ask Lens AI</a></li>
        <li>
          <button type="button" class="nav__expand" aria-expanded="false" aria-controls="nav-products" data-nav-products>
            Products
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <ul class="nav__sub" id="nav-products" hidden>
            {PRODUCTS.map((p) => <li><a href={p.href} data-nav-link>{p.label}</a></li>)}
          </ul>
        </li>
        <li><a href="/about" data-nav-link>Company</a></li>
        <li><a href="/blog" data-nav-link>Blog</a></li>
      </ul>
    </nav>
    <a class="nav__inst" href="/institutional-access" data-nav-link>
      <img src="/images/photos/museum-480.webp" alt="" width="480" height="360" loading="lazy" />
      <span class="nav__inst-text">
        <b>Apply for Institutional Access</b>
        <small>For Institutions &amp; Government Bodies</small>
      </span>
      <span class="nav__inst-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    </a>
  </div>
</header>
