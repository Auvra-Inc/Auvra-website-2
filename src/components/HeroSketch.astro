---
// "The Storyteller": a short illustrated story that plays in the hero when a visitor lingers for a few seconds.
// The headline steps aside and one traveller carries his people's stories through four ink scenes:
// he rides out through the old city gate, reaches Timbuktu, where scholars wrote knowledge into books,
// then Benin, where the king's history lived in music and bronze, and comes home at dusk to tell them again.
// Every moving figure is a real person or animal: Eadweard Muybridge's 1887 motion photographs
// (a man riding a donkey, a walking camel, galloping horses with riders), redrawn frame by frame in ink.
// Scenes are public-domain engravings (Barth's Timbuktu, 1858; Dapper's Benin, 1668) redrawn in ink.

const SCENES = [
  { img: 'gate', w: 1170, h: 1177, caps: ['Long ago, a storyteller rode out through the old city gate, carrying his people’s stories.'] },
  { img: 'timbuktu', w: 1280, h: 750, caps: ['In Timbuktu, scholars wrote stories like his into books that survive to this day.'] },
  { img: 'benin', w: 1280, h: 736, caps: ['In Benin, he heard the king’s history told in music, procession and bronze.'] },
  { img: 'gate', w: 1170, h: 1177, dusk: true, caps: ['He came home at dusk and told them all again, so no one would forget.', 'Today, Auvra keeps every story, for good.'] },
];
// The traveller in each scene: width (% of scene), baseline (% from bottom), delay, crossing time, direction.
const TRAVELLER = [
  { w: 25, b: 7, d: 0.6, t: 14, dir: 1 },
  { w: 20, b: 9, d: -1.5, t: 15, dir: 1 },
  { w: 20, b: 8, d: 0.4, t: 13, dir: 1 },
  { w: 25, b: 7, d: 0.8, t: 16, dir: -1 },
];
// Camel caravan that he travels with in Timbuktu (Muybridge's walking camel).
const CAMELS = [
  [],
  [{ w: 19, b: 2, d: -5 }, { w: 17, b: 4, d: -2 }, { w: 18, b: 1, d: 1 }, { w: 17, b: 3, d: 4.5 }],
  [],
  [],
];
// The king's horsemen in Benin (Muybridge's galloping horse and rider).
const RIDERS = [
  [],
  [],
  [{ w: 26, b: 1, d: 3.6 }, { w: 23, b: 6, d: 4.1 }, { w: 25, b: -1, d: 4.8 }, { w: 24, b: 3, d: 8.6 }],
  [],
];
let capIndex = 0;
const CAPS = SCENES.flatMap((sc) => sc.caps.map((c) => ({ text: c, i: capIndex++ })));
---
<div class="tale" aria-hidden="true" data-tale>
  <div class="tale__stage">
    {SCENES.map((sc, i) => (
      <div class={`tale__scene tale__scene--${sc.img}`} data-scene={i} style={`--ar:${sc.w}/${sc.h}`}>
        <div class="tale__pan">
          <img src={`/images/story/${sc.img}.webp`} srcset={sc.img === 'gate' ? '/images/story/gate-600.webp 585w, /images/story/gate.webp 1170w' : `/images/story/${sc.img}-800.webp 720w, /images/story/${sc.img}.webp 1280w`} sizes="(max-width: 767px) 200vw, 1100px" alt="" loading="lazy" decoding="async" width={sc.w} height={sc.h} />
          {sc.dusk && <>
            <div class="tale__dusk"></div>
            <span class="tale__lamp" style="left:23%;top:61%"></span>
            <span class="tale__lamp" style="left:79%;top:63%;animation-delay:-1.3s"></span>
          </>}
          {CAMELS[i].map((c) => (
            <div class="tale__camel" style={`--w:${c.w};--b:${c.b}%;--d:${c.d}s`}><div class="tale__camelstrip"></div></div>
          ))}
          <div class={`tale__trav ${TRAVELLER[i].dir < 0 ? 'is-left' : ''}`} style={`--w:${TRAVELLER[i].w}%;--b:${TRAVELLER[i].b}%;--d:${TRAVELLER[i].d}s;--t:${TRAVELLER[i].t}s`}>
            <div class="tale__travbox"><div class="tale__travstrip"></div></div>
          </div>
          {RIDERS[i].map((r) => (
            <div class="tale__run" style={`--w:${r.w};--b:${r.b}%;--d:${r.d}s`}>
              <div class="tale__rider"><div class="tale__strip"></div></div>
              <span class="tale__dust"></span>
            </div>
          ))}
        </div>
      </div>
    ))}

    <svg class="tale__birds" viewBox="0 0 120 40">
      <path d="M0,14 Q8,6 16,14 Q24,6 32,14" /><path d="M40,6 Q46,0 52,6 Q58,0 64,6" /><path d="M70,22 Q77,15 84,22 Q91,15 98,22" />
    </svg>
  </div>

  <div class="tale__caps">
    {CAPS.map((c) => <p class="tale__cap" data-cap={c.i}>{c.text}</p>)}
  </div>
</div>

<script is:inline>
  // Plays once the visitor has stayed on the opening screen for about three seconds; any scroll, tap or key ends it.
  (function () {
    var tale = document.querySelector('[data-tale]'); if (!tale) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var hero = tale.closest('section'), timers = [], idle, playing = false, warmed = false;
    var WAIT = 3000, FADE = 1600;
    // Scene lengths (ms); the last scene holds two captions.
    var LEN = [13000, 13000, 13000, 17000];
    var at = function (ms, fn) { timers.push(setTimeout(fn, ms)); };
    var all = ['is-on', 'is-birds', 's-0', 's-1', 's-2', 's-3', 'c-0', 'c-1', 'c-2', 'c-3', 'c-4'];
    var warm = function (sel) {
      tale.querySelectorAll(sel || 'img').forEach(function (im) { im.loading = 'eager'; if (im.decode) im.decode().catch(function () {}); });
    };
    var stop = function () {
      timers.forEach(clearTimeout); timers = []; if (!playing) return;
      playing = false; hero.classList.remove('tale-on');
      all.forEach(function (c) { tale.classList.remove(c); });
      arm(20000);
    };
    var cap = function (n, from, to) {
      at(from, function () { tale.classList.add('c-' + n); });
      at(to, function () { tale.classList.remove('c-' + n); });
    };
    var play = function () {
      if (playing || window.scrollY > innerHeight * 0.4 || document.hidden) return arm(WAIT);
      playing = true; if (!warmed) { warmed = true; warm(); }
      hero.classList.add('tale-on');
      at(250, function () { tale.classList.add('is-on'); });
      var t = 350;
      LEN.forEach(function (len, i) {
        (function (t, i, len) {
          at(t, function () { tale.classList.add('s-' + i); if (i) tale.classList.remove('s-' + (i - 1)); });
          if (i < 3) cap(i, t + 700, t + len - FADE);
          else { cap(3, t + 700, t + 8200); cap(4, t + 9000, t + len - FADE); }
          if (i === 0 || i === 3) at(t + 1200, function () { tale.classList.remove('is-birds'); void tale.offsetWidth; tale.classList.add('is-birds'); });
        })(t, i, len);
        t += len;
      });
      at(t - 600, function () { tale.classList.remove('s-3'); });
      at(t + 200, stop);
    };
    var arm = function (ms) { clearTimeout(idle); idle = setTimeout(play, ms); };
    ['scroll', 'pointerdown', 'keydown', 'touchstart', 'wheel'].forEach(function (ev) {
      addEventListener(ev, function () { if (playing) stop(); else arm(WAIT); }, { passive: true });
    });
    document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); });
    var first = function () { setTimeout(warm, 600, '[data-scene="0"] img'); };
    if (document.readyState === 'complete') first(); else addEventListener('load', first);
    arm(WAIT);
  })();
</script>
