---
// "The Tale of the Gate": a short illustrated story that plays in the hero when a visitor lingers.
// The headline steps aside, an ink drawing of an old city gate washes in, and the story unfolds:
// riders gallop out with news and songs, dusk falls and lanterns glow while elders retell the tales,
// then a full cavalry charge thunders back before the words return.
// Riders are animated from Eadweard Muybridge's 1887 gallop photographs (public domain), redrawn in ink.

const CAPTIONS = [
  'Long ago, every journey began at the old city gate.',
  'Riders carried news, songs and stories between kingdoms.',
  'At night, elders told them again, so no one would forget.',
  'Today, Auvra keeps every story, for good.',
];
const charge1 = [{ w: 30, y: 0, d: 0 }, { w: 26, y: -5, d: 0.55 }, { w: 28, y: 3, d: 1.2 }];
const charge2 = [{ w: 34, y: 2, d: 0 }, { w: 30, y: -6, d: 0.35 }, { w: 32, y: 5, d: 0.8 }, { w: 27, y: -10, d: 1.2 }, { w: 33, y: 8, d: 1.6 }];
---
<div class="tale" aria-hidden="true" data-tale>
  <div class="tale__stage">
    <div class="tale__scene">
      <img class="tale__gate" src="/images/story/gate.webp" srcset="/images/story/gate-600.webp 585w, /images/story/gate.webp 1170w" sizes="(max-width: 767px) 100vw, 640px" alt="" loading="lazy" decoding="async" width="1170" height="1177" />
      <div class="tale__dusk"></div>
      <span class="tale__lamp" style="left:23%;top:61%"></span>
      <span class="tale__lamp" style="left:79%;top:63%"></span>
    </div>

    <svg class="tale__birds" viewBox="0 0 120 40">
      <path d="M0,14 Q8,6 16,14 Q24,6 32,14" /><path d="M40,6 Q46,0 52,6 Q58,0 64,6" /><path d="M70,22 Q77,15 84,22 Q91,15 98,22" />
    </svg>

    <div class="tale__charge tale__charge--out">
      {charge1.map((r) => (
        <div class="tale__run" style={`--w:${r.w};--y:${r.y};--d:${r.d}s`}>
          <div class="tale__rider"><div class="tale__strip"></div></div>
          <span class="tale__dust"></span>
        </div>
      ))}
    </div>
    <div class="tale__charge tale__charge--back">
      {charge2.map((r) => (
        <div class="tale__run" style={`--w:${r.w};--y:${r.y};--d:${r.d}s`}>
          <div class="tale__rider"><div class="tale__strip"></div></div>
          <span class="tale__dust"></span>
        </div>
      ))}
    </div>
  </div>

  <div class="tale__caps">
    {CAPTIONS.map((c, i) => <p class="tale__cap" data-cap={i}>{c}</p>)}
  </div>
</div>

<script is:inline>
  // Plays once the visitor has stayed on the opening screen for a while; any scroll, tap or key ends it.
  (function () {
    var tale = document.querySelector('[data-tale]'); if (!tale) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var hero = tale.closest('section'), timers = [], idle, playing = false;
    var at = function (ms, fn) { timers.push(setTimeout(fn, ms)); };
    var cls = function (c, on) { tale.classList.toggle(c, on); };
    var stop = function () {
      timers.forEach(clearTimeout); timers = []; if (!playing) return;
      playing = false; hero.classList.remove('tale-on');
      ['is-on', 'is-drawn', 'cap-0', 'cap-1', 'cap-2', 'cap-3', 'is-birds', 'is-out', 'is-dusk', 'is-back'].forEach(function (c) { cls(c, false); });
      arm(25000);
    };
    var play = function () {
      if (playing || window.scrollY > innerHeight * 0.4 || document.hidden) return arm(6000);
      playing = true;
      tale.querySelectorAll('img').forEach(function (im) { im.loading = 'eager'; });
      hero.classList.add('tale-on');
      at(500, function () { cls('is-on', true); });
      at(700, function () { cls('is-drawn', true); });
      at(1600, function () { cls('cap-0', true); });
      at(5000, function () { cls('is-birds', true); });
      at(6600, function () { cls('cap-0', false); });
      at(7400, function () { cls('cap-1', true); cls('is-out', true); });
      at(13200, function () { cls('cap-1', false); });
      at(13800, function () { cls('is-out', false); cls('is-dusk', true); cls('cap-2', true); });
      at(19200, function () { cls('cap-2', false); cls('is-dusk', false); });
      at(19900, function () { cls('cap-3', true); cls('is-back', true); });
      at(27000, function () { cls('cap-3', false); });
      at(27800, stop);
    };
    var arm = function (ms) { clearTimeout(idle); idle = setTimeout(play, ms); };
    ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (ev) {
      addEventListener(ev, function () { if (playing) stop(); else arm(6000); }, { passive: true });
    });
    document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); });
    arm(6000);
  })();
</script>
