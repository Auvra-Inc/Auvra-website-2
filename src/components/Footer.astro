---
// Closing call to action on every page (dark card, as in the Option B design), then the footer links.
import StoreButtons from './StoreButtons.jsx';
import { SubscribeForm } from './Forms.jsx';
import { SOCIAL, PARTNERS } from '../data/site.js';

const YEAR = new Date().getFullYear();
// Laid out like the onboard.xyz footer: logo with link columns, a © row, then a short legal note.
const FOOTER_COLS = [
  { title: 'Trust & Safety', links: [{ label: 'Community Guidelines', href: '/community' }, { label: 'Content Governance', href: '/governance' }, { label: 'Copyright Policy', href: '/copyright' }, { label: 'AI Policy', href: '/ai-policy' }] },
  { title: 'Legal', links: [{ label: 'Terms of Service', href: '/terms' }, { label: 'Privacy Policy', href: '/privacy' }, { label: 'AML / CFT Policy', href: '/aml' }] },
  { title: 'Company', links: [{ label: 'About', href: '/about' }, { label: 'Blog', href: '/blog' }] },
  { title: 'Contact', links: [{ label: 'Contact us', href: '/contact' }, { label: 'FAQs', href: '/faqs' }] },
];

const ICONS = {
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>',
  X: '<path fill="currentColor" d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z"/>',
  LinkedIn: '<path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.83v1.54h.06c.53-1 1.84-2.06 3.79-2.06 4.05 0 4.8 2.67 4.8 6.13V21h-4v-4.98c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.92 1.3-1.92 2.63V21h-4V9.75Z"/>',
};
---
<footer class="bg-white" aria-labelledby="footer-cta-title">
  <div class="px-3 md:px-10 pt-10 md:pt-20">
    <div class="relative mx-auto max-w-[1240px] overflow-hidden rounded-[36px] md:rounded-[44px] bg-[#191717] px-6 py-24 md:py-32 text-center" style="background-image: radial-gradient(ellipse 70% 45% at 50% 0%, rgba(120,110,95,.55), rgba(25,23,23,0) 70%)">
      <div class="mx-auto flex max-w-[860px] flex-col items-center gap-7">
        <h2 id="footer-cta-title" class="ws-h text-[#FBF8F1] text-[clamp(44px,9vw,104px)] !leading-[0.92]">What we keep today, tomorrow remembers.</h2>
        <p class="max-w-[36ch] text-[16px] md:text-[20px] leading-relaxed text-[#D9D3C8]">Start preserving your family’s story, your creative work or your community’s heritage today. It’s free to begin.</p>
        <div id="get-app" class="footer-stores mt-4 scroll-mt-40"><StoreButtons variant="light" /></div>
        <div class="footer-sub mt-5 w-full max-w-[380px]"><SubscribeForm client:visible id="footer-email" /></div>
      </div>
    </div>
  </div>
  <section class="partners mx-auto max-w-[1240px] pt-12 md:pt-16" aria-labelledby="partners-title">
    <h2 id="partners-title" class="px-6 text-center text-[14px] md:text-[16px] font-medium uppercase tracking-[0.16em] text-[#4A4540]">Our partners</h2>
    <div class="partners__track-wrap">
      <ul class="partners__track">
        {[0, 1].map((copy) => PARTNERS.map((p) => (
          copy ? <li aria-hidden="true"><img src={p.src} alt="" loading="lazy" decoding="async" style={`height:${p.h}px`} /></li> : <li><img src={p.src} alt={p.name} loading="lazy" decoding="async" style={`height:${p.h}px`} /></li>
        )))}
      </ul>
    </div>
  </section>
  <div class="footer-main mx-auto max-w-[1240px] px-6 md:px-10 pt-10 md:pt-14">
    <div class="footer-grid">
      <div class="flex flex-col gap-3">
        <a href="/" aria-label="Auvra home" class="self-start"><img src="/brand/auvra-lockup-carbon.svg" alt="Auvra" width="111" height="25" loading="lazy" class="footer-logo" /></a>
        <p class="text-[14px] md:text-[15px] text-[#6B6560]">The Permanent Home for Human Culture.</p>
        <ul class="mt-1 flex -ml-2.5 gap-0.5" aria-label="Auvra on social media">
          {SOCIAL.map((s) => (
            <li><a class="footer-social" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`Auvra on ${s.label}`}><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[s.label]} /></a></li>
          ))}
        </ul>
      </div>
      {FOOTER_COLS.map((col) => (
        <nav aria-label={col.title} class="flex flex-col gap-4">
          <h2 class="text-[13px] font-medium uppercase tracking-[0.12em] text-[#6B6560]">{col.title}</h2>
          <ul class="flex flex-col gap-4">{col.links.map((l) => <li><a class="text-[12px] md:text-[14px] leading-tight text-[#4A4540] transition-colors hover:text-[#191717]" href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="mt-14 md:mt-20 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-y border-line py-7 md:py-8 text-[13px] md:text-[15px] text-[#252020]">
      <span>© {YEAR} Auvra Tech Ltd. All rights reserved.</span>
    </div>
    <div class="max-w-[860px] space-y-4 py-8 md:py-10 text-[12.5px] md:text-[14px] leading-relaxed text-[#8A8580]">
      <p>Auvra is operated by Auvra Tech Ltd and is building the permanent home for human culture. Stories, recordings and other cultural records stay credited to the people and communities who share them.</p>
      <p>Lens AI suggestions, including transcripts, translations, tags and Scan results, are drafts that people can review and edit. Features marked as planned or in development are not yet available.</p>
      <p>All trademarks, service marks and partner logos belong to their respective owners.</p>
    </div>
  </div>
  <div class="footer-pattern" aria-hidden="true"></div>
</footer>
