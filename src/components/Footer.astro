---
// Closing call to action on every page (dark card, as in the Option B design), then the footer links.
import StoreButtons from './StoreButtons.jsx';
import { SubscribeForm } from './Forms.jsx';
import { FOOTER, CONTACT_EMAIL, SOCIAL, PARTNERS } from '../data/site.js';
---
<footer class="bg-white" aria-labelledby="footer-cta-title">
  <div class="px-3 md:px-10 pt-10 md:pt-20">
    <div class="relative mx-auto max-w-[1240px] overflow-hidden rounded-[36px] md:rounded-[44px] bg-[#191717] px-6 py-24 md:py-32 text-center" style="background-image: radial-gradient(ellipse 70% 45% at 50% 0%, rgba(120,110,95,.55), rgba(25,23,23,0) 70%)">
      <div class="mx-auto flex max-w-[860px] flex-col items-center gap-7">
        <h2 id="footer-cta-title" class="ws-h text-[#FBF8F1] text-[clamp(44px,9vw,104px)] !leading-[0.92]">What we keep today, tomorrow remembers.</h2>
        <p class="max-w-[30ch] text-[18px] md:text-[22px] leading-relaxed text-[#D9D3C8]">Start preserving your family’s story today. It’s free to begin.</p>
        <div id="get-app" class="footer-stores mt-4 scroll-mt-40"><StoreButtons variant="light" /></div>
        <div class="footer-sub mt-6 w-full max-w-[560px]"><SubscribeForm client:visible id="footer-email" /></div>
      </div>
    </div>
  </div>
  <section class="partners mx-auto max-w-[1240px] pt-14 md:pt-20" aria-labelledby="partners-title">
    <h2 id="partners-title" class="px-6 text-center text-xs uppercase tracking-[0.14em] text-[#626262]">Our partners</h2>
    <div class="partners__track-wrap">
      <ul class="partners__track">
        {[0, 1].map((copy) => PARTNERS.map((p) => (
          <li aria-hidden={copy ? 'true' : undefined}><img src={p.src} alt={copy ? '' : p.name} loading="lazy" /></li>
        )))}
      </ul>
    </div>
  </section>
  <div class="mx-auto grid max-w-[1240px] gap-12 px-6 md:px-10 py-16 md:grid-cols-[1.2fr_2fr]">
    <div class="flex flex-col gap-4">
      <a href="/" aria-label="Auvra home"><img src="/brand/auvra-logo-carbon.svg" alt="Auvra" width="150" height="42" loading="lazy" class="h-10 w-auto" /></a>
      <p class="text-grey">Building the Permanent Home for Human Culture.</p>
      <a class="font-medium underline underline-offset-4" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <ul class="flex flex-wrap gap-x-6">{SOCIAL.map((s) => <li><a class="inline-flex min-h-[44px] items-center hover:underline" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}</ul>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {FOOTER.map((col) => (
        <nav aria-label={col.title} class="flex flex-col gap-3">
          <h2 class="text-xs uppercase tracking-[0.12em] text-[#626262]">{col.title}</h2>
          <ul class="flex flex-col">{col.links.map((l) => <li><a class="inline-flex min-h-[40px] items-center text-[15px] hover:underline" href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
  </div>
  <div class="mx-auto flex max-w-[1240px] flex-wrap justify-between gap-2 border-t border-line px-6 md:px-10 py-6 text-sm text-[#626262]">
    <span>© Auvra. All rights reserved.</span><span>Lagos, Nigeria</span>
  </div>
</footer>
