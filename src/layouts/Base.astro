---
import '../styles/global.css';
import Nav from '../components/Nav.jsx';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import IconSprite from '../components/IconSprite.jsx';
import { SITE, SOCIAL, CONTACT_EMAIL, SUPPORT_EMAIL, STORE } from '../data/site.js';

/**
 * Every page: unique title + description, canonical URL, Open Graph / X cards,
 * Organization + WebSite JSON-LD, optional BreadcrumbList and page-specific JSON-LD.
 * crumbs: [{ label, href? }] (Home is added automatically).
 */
const { title, description, image = '/og-image.jpg', jsonld = [], crumbs = null, noindex = false, ogType = 'website' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = SITE + (path === '/' ? '/' : path);
const ogImage = image.startsWith('http') ? image : SITE + image;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE}/#organization`,
  name: 'Auvra', legalName: 'Auvra Tech Ltd', url: SITE, email: CONTACT_EMAIL,
  identifier: { '@type': 'PropertyValue', propertyID: 'CAC RC Number (Nigeria)', value: '8895504' },
  foundingLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressCountry: 'NG' } },
  logo: { '@type': 'ImageObject', url: `${SITE}/brand/auvra-lockup-v2-carbon.svg` },
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'customer support', email: SUPPORT_EMAIL, availableLanguage: ['en'] },
    { '@type': 'ContactPoint', contactType: 'general enquiries', email: CONTACT_EMAIL, availableLanguage: ['en'] },
  ],
  knowsAbout: ['Cultural preservation', 'Oral history', 'African languages', 'Transcription', 'Translation', 'Digital heritage', 'Family history'],
  description: 'Auvra is a cultural technology platform building the permanent home for human culture. It develops digital infrastructure that helps individuals, families, creators and communities preserve, own and pass down cultural heritage across generations.',
  sameAs: SOCIAL.map((s) => s.href), address: { '@type': 'PostalAddress', addressLocality: 'Lagos', addressCountry: 'NG' },
};
const site = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE}/#website`, name: 'Auvra', url: SITE, inLanguage: 'en', publisher: { '@id': `${SITE}/#organization` } };
const webpage = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: 'en', isPartOf: { '@id': `${SITE}/#website` }, about: { '@id': `${SITE}/#organization` }, primaryImageOfPage: ogImage };
const BING = import.meta.env.PUBLIC_BING_VERIFICATION;
const SENTRY_DSN = import.meta.env.PUBLIC_SENTRY_DSN;
const breadcrumb = crumbs && {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [{ label: 'Home', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: SITE + (c.href || path) })),
};
const ld = [org, site, ...(noindex ? [] : [webpage]), ...(breadcrumb ? [breadcrumb] : []), ...jsonld];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Auvra, AI cultural preservation, cultural preservation platform, Lens AI, oral history transcription, translation, African languages, heritage, family history, diaspora" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" type="text/plain" title="Auvra for AI assistants" href="/llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="author" content="Auvra Tech Ltd" />
    <meta name="format-detection" content="telephone=no" />
    {BING && <meta name="msvalidate.01" content={BING} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="google-site-verification" content="uOCh-LWh0XBkm1lh4x4veDm4ZzqKMAjUVBEFtEmTMHQ" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Auvra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@goauvra" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preload" as="style" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" /></noscript>
    <script is:inline>document.documentElement.classList.add('js');
      // Reveal content as soon as it nears the viewport, without waiting for the animation bundle.
      (function () {
        var show = function (el) { el.classList.add('is-in'); };
        var run = function () {
          var els = document.querySelectorAll('.reveal:not(.is-in), .slide-in:not(.is-in)');
          if (!('IntersectionObserver' in window)) { els.forEach(show); return; }
          var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px 20% 0px' });
          els.forEach(function (el) { io.observe(el); });
        };
        document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', run) : run();
        setTimeout(function () { document.querySelectorAll('.reveal, .slide-in').forEach(function (el) { if (el.getBoundingClientRect().top < innerHeight * 1.2) show(el); }); }, 1500);
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <IconSprite />
    <Nav client:idle pathname={path} />
    <main id="main"><slot /></main>
    <Footer />
    {SENTRY_DSN && (
      <script is:inline define:vars={{ dsn: SENTRY_DSN }}>
        // Error tracking (Sentry), only when PUBLIC_SENTRY_DSN is set.
        (function () { var s = document.createElement('script'); s.src = 'https://browser.sentry-cdn.com/8.47.0/bundle.min.js'; s.crossOrigin = 'anonymous'; s.onload = function () { window.Sentry && window.Sentry.init({ dsn: dsn, tracesSampleRate: 0.1 }); }; document.head.appendChild(s); })();
      </script>
    )}
    <script is:inline define:vars={{ store: STORE }}>
      // Explore Auvra: straight to the right app store on phones, else scroll to the download buttons.
      document.addEventListener('click', (e) => {
        const a = e.target.closest && e.target.closest('a[href="#get-app"]');
        if (!a) return;
        e.preventDefault();
        const ua = navigator.userAgent || '';
        const ios = /iPhone|iPad|iPod/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        const android = /Android/i.test(ua);
        if (store.live && ios) { location.href = store.appStore; return; }
        if (store.live && android) { location.href = store.googlePlay; return; }
        const t = document.getElementById('get-app');
        if (!t) return;
        if (window.__lenis) window.__lenis.scrollTo(t, { offset: -160 });
        else t.scrollIntoView({ behavior: 'smooth', block: 'center' });
        t.classList.remove('is-pinged'); void t.offsetWidth; t.classList.add('is-pinged');
      });
    </script>
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
