---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IconSprite from '../components/IconSprite.astro';
import { SOCIAL, CONTACT_EMAIL } from '../data/site.js';

interface Props { title?: string; description?: string; jsonld?: object[]; bodyClass?: string }
const {
  title = 'Auvra · AI-powered cultural preservation platform',
  description = 'Auvra is an AI-powered platform for preserving human culture. Record stories, languages and oral histories as permanent records, with Lens AI transcription.',
  jsonld = [],
  bodyClass = '',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Auvra',
  legalName: 'Auvra Tech Ltd',
  url: 'https://goauvra.com',
  logo: 'https://goauvra.com/brand/auvra-logo-carbon.svg',
  email: CONTACT_EMAIL,
  sameAs: SOCIAL.map((s) => s.href),
  address: { '@type': 'PostalAddress', addressLocality: 'Lagos', addressCountry: 'NG' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Auvra, cultural preservation, Lens AI, oral history, African languages, transcription, translation, heritage, family history, diaspora" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Auvra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://goauvra.com/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://goauvra.com/og-image.jpg" />
    <link rel="preload" href="/fonts/bricolage-grotesque-variable.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonld])} />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <IconSprite />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
