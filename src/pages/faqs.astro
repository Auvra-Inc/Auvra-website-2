---
import Base from '../layouts/Base.astro';
import { HOME_FAQS, MORE_FAQS } from '../data/site.js';
const all = [...HOME_FAQS, ...MORE_FAQS];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: all.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title="FAQs · Auvra" description="Answers to common questions about Auvra, Lens AI, My Vault, Communities, privacy and getting started." jsonld={[faqLd]}>
  <section class="wrap page-hero">
    <p class="kicker">FAQs</p>
    <h1 class="h2">Frequently asked questions</h1>
    <p class="lead">Can't find what you need? <a href="/contact">Contact us</a> and we'll help.</p>
  </section>
  <section class="wrap" style="padding-bottom: var(--sec)">
    <div class="faq" data-faq style="max-width: 860px">
      {all.map((f, i) => (
        <div class="faq__item">
          <h2>
            <button type="button" class="faq__q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>
              {f.q}<span class="faq__icon" aria-hidden="true"></span>
            </button>
          </h2>
          <div class="faq__a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} data-open={i === 0 ? 'true' : 'false'}>
            <div><p>{f.a}</p></div>
          </div>
        </div>
      ))}
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:40px">
      <a class="btn btn--dark" href="/contact">Contact us</a>
      <a class="btn btn--ghost" href="/">Back to home</a>
    </div>
  </section>
</Base>
<style>.lead a { color: var(--blue); } .faq h2 { font: inherit; }</style>
