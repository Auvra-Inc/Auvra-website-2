  .toc h2 { margin-top: 0; font-size: 20px; }
  .toc ul { list-style: none; padding-left: 0; columns: 2 240px; column-gap: 28px; }
  .toc li { break-inside: avoid; margin: 0 0 6px; }
  .legal section { scroll-margin-top: 100px; }
  .table-scroll { overflow-x: auto; margin-bottom: 14px; }
