---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · Auvra" description="This page could not be found.">
  <section class="wrap page-hero" style="padding-bottom: var(--sec)">
    <p class="kicker">404</p>
    <h1 class="h2">This page has not been preserved</h1>
    <p class="lead">The link may be old or mistyped. Try the homepage or our FAQs.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:30px">
      <a class="btn btn--dark" href="/">Go home</a>
      <a class="btn btn--ghost" href="/faqs">Read FAQs</a>
    </div>
  </section>
</Base>
