---
import Base from '../layouts/Base.astro';
import AChronos, { CHRONOS_FAQS } from '../views/technology/AChronos.jsx';
import { faqJsonLd } from '../views/editorial.jsx';
import { SITE } from '../data/site.js';
import { DEFINITIONS } from '../data/definitions.js';

const description = 'A-Chronos is Auvra’s foundational model research initiative for cultural heritage: AI that understands cultural knowledge, context and how records relate.';
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE}/a-chronos#webpage`,
  url: `${SITE}/a-chronos`,
  name: 'A-Chronos',
  description: DEFINITIONS.aChronos.long,
  isPartOf: { '@id': `${SITE}/#website` },
  publisher: { '@id': `${SITE}/#organization` },
};
---
<Base
  title="A-Chronos · Foundational AI Research for Cultural Heritage · Auvra"
  description={description}
  crumbs={[{ label: 'Technology' }, { label: 'A-Chronos' }]}
  jsonld={[pageLd, faqJsonLd(CHRONOS_FAQS)]}
>
  <AChronos />
</Base>
