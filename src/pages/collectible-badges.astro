---
import Base from '../layouts/Base.astro';
import View, { FAQS } from '../views/products/CollectibleBadges.jsx';
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="Collectible Badges · Cultural expressions shared with their creators credited · Auvra" description="Collectible Badges let creators document, attribute and share cultural expressions such as artwork, music and craft as digital or physical items that carry their cultural context." crumbs={[{ label: 'Products', href: '/#ecosystem' }, { label: 'Collectible Badges' }]} jsonld={[faqLd]}>
  <View />
</Base>
