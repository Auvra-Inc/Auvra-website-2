  <script>
    // Curved wall: cards drift continuously along a concave curve; the copy follows the topic photo passing the centre.
    const sec = document.querySelector('[data-wall]');
    if (sec) {
      const cards = [...sec.querySelectorAll('.wall__card')];
      const N = cards.length;
      const stops = JSON.parse(sec.dataset.stops || '[]');
      const groups = [sec.querySelectorAll('.wall-word'), sec.querySelectorAll('.wall-line'), sec.querySelectorAll('.wall__chip'), sec.querySelectorAll('.wall-pip')];
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const SPEED = 0.32; // cards per second
      let pos = 0, last = 0, topic = -1, visible = false, raf = 0;

      const layout = () => {
        const w = cards[0].offsetWidth || 80;
        const sp = w * 1.08;
        const mob = innerWidth < 768;
        cards.forEach((c, i) => {
          let o = ((i - pos) % N + N) % N; if (o > N / 2) o -= N;
          const a = Math.abs(o);
          const x = Math.sign(o) * (a * sp + a * a * sp * (mob ? 0.09 : 0.06));
          const s = 1 + a * a * (mob ? 0.045 : 0.035) + a * (mob ? 0.06 : 0.05);
          c.style.transform = `translate(-50%, -50%) translateX(${x}px) rotateY(${o * (mob ? -14 : -11)}deg) scale(${s})`;
          c.style.zIndex = String(100 - Math.round(a * 10));
          c.style.opacity = a > N / 2 - 1.2 ? '0' : '1';
        });
        // Topic = the most recent topic photo to reach the centre.
        const front = ((Math.round(pos) % N) + N) % N;
        let k = -1;
        for (let j = 0; j < stops.length; j++) if (stops[j] <= front) k = j;
        if (k === -1) k = stops.length - 1;
        if (k !== topic) { topic = k; groups.forEach((list) => list.forEach((el, j) => el.classList.toggle('is-on', j === k))); }
      };
      const tick = (t) => {
        const dt = last ? Math.min(0.05, (t - last) / 1000) : 0; last = t;
        pos = (pos + dt * SPEED) % N; layout();
        raf = visible ? requestAnimationFrame(tick) : 0;
      };
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible && !reduce && !raf) { last = 0; raf = requestAnimationFrame(tick); }
      }, { threshold: 0.05 }).observe(sec);
      addEventListener('resize', layout);
      pos = (stops[0] || 0) - 0.3; layout();
    }
  </script>

