---
// Homepage, laid out like wysemarket.com: hero → dark intro with three tiles → product features →
// poster statement → how it works carousel → dark FAQ + movement strip → gradient CTA footer.
import Base from '../layouts/Base.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Icon3D from '../components/Icon3D.jsx';
import Carousel from '../components/Carousel.jsx';
import Faq from '../components/Faq.jsx';
import StoreButtons from '../components/StoreButtons.jsx';
import { MOVEMENT, EXPLORE_HREF } from '../data/site.js';
import { DEFINITIONS } from '../data/definitions.js';
import { FAQ_GROUPS } from '../data/faqs.js';

const faqGroup = (t) => FAQ_GROUPS.find((g) => g.title === t).items;
const homeFaqs = [
  faqGroup('About Auvra')[0], // What is Auvra?
  faqGroup('About Auvra')[1], // What problem is Auvra solving?
  faqGroup('Cultural Badges')[0], // What is a Badge?
  faqGroup('My Vault')[0], // What is My Vault?
  faqGroup('Technology')[0], // What is Lens AI?
  faqGroup('About Auvra')[2], // Who is Auvra building for?
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const tiles = [
  { label: 'Record or upload', icon: 'mic', bg: 'radial-gradient(circle at 50% 45%, #FFFFFF 0%, #E9DDFB 45%, #CDB8F0 100%)', strip: '#DCCBF7' },
  { label: 'Lens AI understands it', icon: 'sparkle', bg: 'radial-gradient(circle at 50% 45%, #FFFFFF 0%, #FFE3D6 45%, #FFC2AE 100%)', strip: '#FFD8C8' },
  { label: 'Own it and pass it on', icon: 'gift', bg: 'radial-gradient(circle at 50% 45%, #FFFFFF 0%, #E2F0D6 45%, #C3DFAA 100%)', strip: '#D6EAC4' },
];
const features = [
  { art: 'pocket-watch', name: 'Cultural Preservation', text: 'The heart of Auvra. Document stories, languages and traditions, and keep them credited with two types of digital badges.', href: '/cultural-preservation',
    badges: [{ art: 'coin', name: 'Contribution Badges', href: '/badges#contribution' }, { art: 'chess-knight', name: 'Creator Badges', href: '/badges#creator' }] },
  { art: 'key', name: 'My Vault', text: DEFINITIONS.myVault.short, href: '/my-vault' },
  { art: 'paper-plane', name: 'Auvra Passport', text: DEFINITIONS.auvraPassport.short, href: '/auvra-passport' },
  { art: 'magnifier', name: 'Lens AI', text: 'AI that transcribes and translates oral histories, tags cultural items and makes archives searchable. You can always review and edit what it writes.', href: '/lens-ai' },
  { art: 'camera', name: 'Scan', text: DEFINITIONS.scan.short, href: '/lens-ai#scan', isNew: true },
  { art: 'hourglass', name: 'A-Chronos', text: DEFINITIONS.aChronos.short, href: '/a-chronos' },
];
const steps = [
  { n: 1, title: 'Download Auvra', text: 'Create your free Auvra account in seconds on iPhone or Android.', bg: '#024B50', chip: '#0B6A70', accent: '#BCE784' },
  { n: 2, title: 'Choose your path', text: 'Pick the one that fits how you preserve, then invite the people who matter.', options: ['Creator', 'Collector', 'Community', 'Vault'], bg: '#4A281C', chip: '#6D4435', accent: '#FF8F77' },
  { n: 3, title: 'Record and upload', text: 'Add voice notes, photos and documents. Lens AI transcribes and translates them.', bg: '#3310BE', chip: '#5A3BE0', accent: '#DCD5FF' },
  { n: 4, title: 'Pass it down', text: 'Your culture is preserved, credited to you, and ready for the next generation.', bg: '#E2583F', chip: '#F07B64', accent: '#FFF4D6' },
];
const WALL_CARDS = ['singers', 'drummer-blue', 'creator-filmmaker', 'creator-filmcrew', 'creator-painter', 'creator-studio', 'hands-braid', 'elder', 'coral-beads', 'dancers', 'creator-joy', 'creator-beach', 'gele', 'young-man'];
const WALL_TOPICS = [
  { word: 'music', label: 'Music', card: 0, line: 'Songs, voice notes and live sessions, transcribed by Lens AI and credited to the artist who made them.' },
  { word: 'films', label: 'Film', card: 2, line: 'Short films and behind-the-scenes footage, kept in one place with the story behind every shot.' },
  { word: 'art', label: 'Art & craft', card: 4, line: 'Paintings, craft and design work, documented with the context that makes them yours.' },
  { word: 'family', label: 'Family recordings', card: 6, line: 'Grandma’s voice, recorded once and translated by Lens AI for every generation after her.' },
  { word: 'community', label: 'Community archives', card: 8, line: 'Festivals, songs and ceremonies, kept by the communities that carry them, with their permission.' },
  { word: 'moments', label: 'Everyday moments', card: 10, line: 'The photos and moments in between, kept safe and private in your Vault.' },
];
const audiences = [
  { id: 'families', name: 'Families' }, { id: 'creators', name: 'Creators' }, { id: 'communities', name: 'Communities' },
  { id: 'diaspora', name: 'Diaspora' }, { id: 'institutions', name: 'Museums & Institutions' },
];
---
<Base
  title="Auvra · Your story. Your culture. Your legacy."
  description="Auvra is a cultural technology company building the permanent home for human culture: infrastructure to preserve, own and pass down cultural heritage and traditions across generations."
  jsonld={[faqLd]}
>
  <!-- 1 · Hero -->
  <section id="home" class="flex flex-col" aria-labelledby="hero-title">
    <div class="relative flex flex-col overflow-hidden px-3 md:px-[3.25rem] pt-40 md:pt-48 pb-20 md:pb-28" style="background: linear-gradient(180deg, #F4F0E8 0%, #F7F4EE 45%, #FCFBF8 75%, #FFFFFF 100%)">
      <div class="relative z-10 mx-auto flex max-w-[1240px] flex-col items-center gap-10 md:gap-8 text-center">
        <h1 id="hero-title" class="ws-h text-carbon hero-h1 !leading-[0.96] text-[15.5vw] md:text-[clamp(60px,8vw,116px)] md:!leading-[0.98]">
          {[['Your', 'story.'], ['Your', 'culture.'], ['Your', 'legacy.']].map(([a, b]) => (
            <span class={`hero-line block md:whitespace-nowrap${b === 'culture.' ? ' serif-accent' : ''}`}><span class="hero-word block md:inline">{a}</span> <span class="hero-word block md:inline">{b}</span></span>
          ))}
        </h1>
        <p class="max-w-sm md:max-w-md text-[15px] md:text-xl font-medium leading-relaxed text-[#3A3631]">Keep the stories, languages and traditions that make you who you are, with Lens AI to capture and translate them.</p>
        <div class="hero-stores"><StoreButtons /></div>
      </div>
    </div>
    <!-- Phone: sliding photos, each with its own app card -->
    <div class="hero-slides md:hidden" aria-label="Examples of what people keep on Auvra">
      <div class="hero-slide" style="--i:0">
        <img src="/images/photos/creator-painter-960.webp" alt="An artist in a brown leather jacket standing in front of a large geometric painting" class="object-[50%_30%]" fetchpriority="high" />
        <div class="hero-slide__card">
          <div class="flex items-center gap-3">
            <img src="/images/photos/hands-braid-480.webp" alt="" class="h-12 w-12 rounded-xl object-cover" />
            <div class="text-left"><p class="text-[16px] font-semibold leading-tight">How our family began</p><p class="text-[13px] text-grey">Told by Grandma Nneoma · Igbo · 2:14</p></div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 text-center text-[15px] font-medium"><span class="rounded-xl bg-[#E8F1E4] py-2.5 text-[#2F6B12]">▶ Listen</span><span class="rounded-xl bg-[#ECE8FF] py-2.5 text-blue">Translate</span></div>
          <p class="mt-3 text-center text-[12px] text-grey">Igbo → English · Transcribed by Lens AI</p>
        </div>
      </div>
      <div class="hero-slide" style="--i:1">
        <img src="/images/photos/dancer-sky-960.webp" alt="A dancer in a feathered bustle leaping against a blue sky" class="object-[35%_30%]" loading="lazy" />
        <div class="hero-slide__card">
          <div class="flex items-center gap-3"><span class="grid h-12 w-12 place-items-center rounded-xl bg-[#ECE8FF]"><Icon3D name="sparkle" size={34} /></span><p class="text-[16px] font-semibold text-blue">Lens AI · Translation</p></div>
          <p class="mt-4 text-[11px] font-semibold uppercase tracking-wider text-grey">Igbo</p>
          <p class="font-serif text-[17px] leading-snug">Nna nna anyị si Nnewi bịa</p>
          <p class="mt-2 text-[11px] font-semibold uppercase tracking-wider text-grey">English</p>
          <p class="font-serif text-[17px] leading-snug">Our great-grandfather came from Nnewi</p>
        </div>
      </div>
      <div class="hero-slide" style="--i:2">
        <img src="/images/photos/creator-beach-960.webp" alt="A young woman laughing on a seaside wall under a bright blue sky" class="object-[48%_55%]" loading="lazy" />
        <div class="hero-slide__card hero-slide__card--top">
          <div class="flex items-center gap-3"><span class="grid h-12 w-12 place-items-center rounded-xl bg-[#E8F1E4]"><Icon3D name="vault" size={34} /></span><div class="text-left"><p class="text-[16px] font-semibold leading-tight">Okafor Family Vault</p><p class="text-[13px] text-grey">Private · shared by invitation</p></div></div>
          <ul class="mt-4 space-y-2.5 text-[14px]">
            <li class="flex items-center justify-between"><span class="flex items-center gap-2"><img src="/images/photos/elder-480.webp" alt="" class="h-6 w-6 rounded-full object-cover" />Grandma Nneoma</span><span class="text-grey">12 memories</span></li>
            <li class="flex items-center justify-between"><span class="flex items-center gap-2"><img src="/images/photos/young-man-480.webp" alt="" class="h-6 w-6 rounded-full object-cover" />Chidi</span><span class="text-grey">5 memories</span></li>
          </ul>
        </div>
      </div>
      <div class="hero-slide" style="--i:3">
        <img src="/images/photos/creator-filmmaker-960.webp" alt="A filmmaker operating a video camera rig" class="object-[60%_35%]" loading="lazy" />
        <div class="hero-slide__card">
          <div class="flex items-center gap-3"><span class="grid h-12 w-12 place-items-center rounded-xl bg-[#FFE9E3]"><Icon3D name="shield" size={34} /></span><div class="text-left"><p class="text-[16px] font-semibold leading-tight">Short film · Lagos nights</p><p class="text-[13px] text-grey">Uploaded by the director · 12:40</p></div></div>
          <div class="mt-4 flex items-center justify-between rounded-xl bg-linen px-3 py-2.5 text-[14px]"><span class="font-semibold text-[#2F6B12]">✓ Preserved</span><span class="text-grey">Credited to you</span></div>
        </div>
      </div>
      <div class="hero-slides__dots" aria-hidden="true">{[0, 1, 2, 3].map((i) => <span style={`--i:${i}`}></span>)}</div>
    </div>
    <div class="relative isolate hidden md:grid h-[640px] md:h-[732px] grid-cols-1 md:grid-cols-2 lg:grid-cols-3 overflow-x-clip">
      <img src="/images/photos/creator-painter-960.webp" srcset="/images/photos/creator-painter-480.webp 480w, /images/photos/creator-painter-960.webp 960w" sizes="(max-width: 767px) 100vw, 34vw" alt="An artist in a brown leather jacket standing in front of a large geometric painting" class="md:hidden lg:block h-full w-full object-cover object-[50%_30%]" fetchpriority="high" />
      <img src="/images/photos/dancer-sky-1400.webp" srcset="/images/photos/dancer-sky-960.webp 960w, /images/photos/dancer-sky-1400.webp 1400w" sizes="(max-width: 767px) 100vw, 50vw" alt="A dancer in a feathered bustle and fringed regalia leaping against a blue sky" class="hidden md:block h-full w-full object-cover object-[40%_30%]" loading="lazy" />
      <img src="/images/photos/creator-joy-1400.webp" srcset="/images/photos/creator-joy-480.webp 480w, /images/photos/creator-joy-960.webp 960w, /images/photos/creator-joy-1400.webp 1400w" sizes="34vw" alt="A young woman with curly hair laughing with her arms wide under a blue sky" class="hidden md:block h-full w-full object-cover object-[52%_30%]" loading="lazy" />
      <div class="hidden lg:block absolute left-[3.5%] top-[64%] z-10 w-[360px] rounded-[24px] bg-white/50 p-2">
        <div class="rounded-[18px] bg-white p-5 shadow-xl text-left">
          <div class="flex items-center gap-3"><img src="/images/photos/gele-480.webp" alt="" class="h-11 w-11 rounded-xl object-cover" /><p class="text-[16px] font-semibold leading-tight">Okafor Family Vault</p></div>
          <ul class="mt-4 space-y-2.5 text-[14px]">
            <li class="flex items-center justify-between"><span class="flex items-center gap-2"><img src="/images/photos/elder-480.webp" alt="" class="h-6 w-6 rounded-full object-cover" />Grandma Nneoma</span><span class="text-grey">12 memories</span></li>
            <li class="flex items-center justify-between"><span class="flex items-center gap-2"><img src="/images/photos/young-man-480.webp" alt="" class="h-6 w-6 rounded-full object-cover" />Chidi</span><span class="text-grey">5 memories</span></li>
          </ul>
          <p class="mt-4 border-t border-line pt-3 text-[13px] text-grey">Private · shared by invitation</p>
        </div>
      </div>
      <div class="absolute left-1/2 top-[74%] md:top-[72%] z-10 w-[78%] md:max-w-[420px] -translate-x-1/2 -translate-y-1/2 rounded-2xl md:rounded-[24px] bg-white/50 p-2">
        <div class="rounded-[18px] bg-white p-5 shadow-2xl">
          <div class="flex items-center gap-3">
            <img src="/images/photos/hands-braid-480.webp" alt="" class="h-12 w-12 rounded-xl object-cover" />
            <div class="text-left"><p class="text-[16px] md:text-[17px] font-semibold leading-tight">How our family began</p><p class="text-[13px] text-grey">Told by Grandma Nneoma · Igbo · 2:14</p></div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 text-center text-[15px] font-medium">
            <span class="rounded-xl bg-[#E8F1E4] py-2.5 text-[#2F6B12]">▶ Listen</span>
            <span class="rounded-xl bg-[#ECE8FF] py-2.5 text-blue">Translate</span>
          </div>
          <p class="mt-3 text-center text-[12px] text-grey">Igbo → English · Transcribed by Lens AI</p>
        </div>
      </div>
      <div class="hidden lg:block absolute right-[3.5%] top-[56%] z-10 w-[360px] rounded-[24px] bg-white/50 p-2">
        <div class="rounded-[18px] bg-white p-5 shadow-xl text-left">
          <p class="flex items-center gap-2 text-[14px] font-semibold text-blue">✦ Lens AI · Translation</p>
          <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-grey">Igbo</p>
          <p class="font-serif text-[17px] leading-snug">Nna nna anyị si Nnewi bịa</p>
          <p class="mt-2 text-[11px] font-semibold uppercase tracking-wider text-grey">English</p>
          <p class="font-serif text-[17px] leading-snug">Our great-grandfather came from Nnewi</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · Dark intro + three tiles -->
  <section class="flex flex-col items-center gap-y-[7.5rem] bg-[#191717] pt-[4.4rem] md:pt-[8.75rem]" aria-labelledby="intro-title">
    <div class="reveal flex max-w-[820px] flex-col items-center gap-8 md:gap-[3.25rem] px-10 text-center">
      <h2 id="intro-title" class="ws-h text-[#FBF8F1] text-[2.5rem] leading-[2.1rem] md:text-[3.75rem] md:leading-[3.4rem]">The platform built for families and creators</h2>
      <p class="max-w-[600px] text-sm md:text-lg md:leading-7 text-[#888]">Whether you are recording your grandmother’s stories, releasing music, shooting film or making art, Auvra keeps your work and memories safe, organised and credited to you, for good.</p>
    </div>
    <ul class="grid w-full grid-cols-1 md:grid-cols-3 md:divide-x md:divide-[#2B2B2B]">
      {tiles.map((t) => (
        <li class="flex h-[516px] md:h-[645px] flex-col">
          <div class="relative flex flex-1 items-center justify-center" style={`background:${t.bg}`}>
            <Icon3D name={t.icon} size={230} />
            <p class="absolute bottom-8 md:bottom-[3.4rem] text-lg text-[#191717]">{t.label}</p>
          </div>
          <div class="h-[30px]" style={`background:${t.strip}`}></div>
        </li>
      ))}
    </ul>
  </section>

  <!-- 3 · Product features -->
  <section id="features" class="mx-auto flex max-w-[1280px] flex-col max-lg:gap-y-24 bg-white py-16 md:pt-[4.6rem] md:pb-40 px-8 xl:px-12 scroll-mt-24" aria-labelledby="features-title">
    <div class="flex items-center justify-between gap-10">
      <div class="flex flex-col max-md:items-center max-md:text-center">
        <p class="mb-4 text-sm md:text-base uppercase text-[#272727]">Product features</p>
        <h2 id="features-title" class="reveal ws-h mb-10 lg:mb-[3.4rem] text-[2.35rem] leading-[2.1rem] md:text-[3rem] md:leading-[3.4rem] lg:text-[3.75rem]">What you need to know about Auvra</h2>
        <p class="reveal max-w-[300px] md:max-w-[600px] text-sm md:text-base lg:text-lg text-[#272727]">One app for everything you keep: a private Vault, an identity that keeps you credited, badges for what you add and create, and AI that helps you understand what you hold.</p>
      </div>
      <div class="hidden md:block w-[300px] lg:w-[340px] flex-none -rotate-6">
        <PhoneFrame label="Lens AI in the Auvra app transcribing and translating a grandparent's recording">
          <div class="flex h-full flex-col gap-3 bg-white px-4 pt-[18%] text-carbon">
            <p class="flex items-center gap-2 text-[15px] font-semibold"><span class="grid h-7 w-7 place-items-center rounded-lg bg-blue text-white">✦</span>Lens AI</p>
            <p class="self-end rounded-2xl rounded-br-md bg-carbon px-3 py-2 text-[12px] text-white">Transcribe Grandpa's recording and translate it to English.</p>
            <p class="rounded-2xl rounded-bl-md bg-[#F2EFFF] px-3 py-2 text-[12px]">Done. Here is the transcript and the English translation. I tagged it <b class="text-blue">Family history</b> and <b class="text-blue">Nnewi</b>.</p>
            <div class="flex flex-wrap gap-1.5">{['View transcript', 'Translate to French'].map((c) => <span class="rounded-full border border-[#DCD5FF] px-2.5 py-1 text-[10px] font-medium text-blue">{c}</span>)}</div>
          </div>
        </PhoneFrame>
      </div>
    </div>
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-y-12 md:gap-x-5 lg:gap-y-[5.5rem] md:mt-20">
      {features.map((f) => (
        <li class="flex flex-col">
          <img src={`/images/collage/${f.art}.webp`} alt="" aria-hidden="true" class="h-28 lg:h-32 w-auto self-start object-contain" loading="lazy" />
          <div class="reveal">
            <h3 class="mt-6 lg:mt-8 mb-2 lg:mb-5 flex items-center gap-2 text-xl font-semibold text-[#252020]"><a href={f.href} class="hover:underline">{f.name}</a>{f.isNew && <span class="rounded-full bg-[#191717] px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-white">New</span>}</h3>
            <p class="text-base text-[#626262]">{f.text}</p>
            {f.badges && (
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Badge types">
                {f.badges.map((b) => (
                  <li><a href={b.href} class="inline-flex items-center gap-2 rounded-full border border-[#E7E2DA] bg-[#FBF8F1] py-1 pl-1 pr-3.5 text-[14px] font-medium text-[#252020] transition-colors hover:bg-[#F4F0E8]"><img src={`/images/collage/${b.art}.webp`} alt="" class="h-7 w-7 rounded-full bg-white object-contain p-0.5" loading="lazy" />{b.name}</a></li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>


  <!-- Evolution collage: objects across generations -->
  <section class="bg-[#FBF8F1] px-6 py-24 md:py-36" aria-labelledby="evo-title">
    <ul class="mx-auto flex max-w-[980px] items-end justify-center gap-3 md:gap-8" aria-hidden="true">
      {[
        ['pocket-watch', 'bg-[#D9EEDC]', '-rotate-2'],
        ['coin', '', ''],
        ['key', 'bg-[#FFD3BE]', 'rotate-2'],
        ['chess-knight', '', ''],
        ['paper-plane', 'bg-[#D6D3FF]', '-rotate-3'],
      ].map(([n, patch, rot], i) => (
        <li class={`relative flex flex-1 items-end justify-center ${i % 2 ? 'pb-2' : 'pb-8 md:pb-14'}`}>
          {patch && <span class={`absolute inset-x-[4%] bottom-[8%] top-[18%] ${patch} ${rot}`} style="clip-path: polygon(2% 0, 100% 3%, 97% 100%, 0 96%)"></span>}
          <img src={`/images/collage/${n}.webp`} alt="" class="reveal relative w-full max-w-[150px] object-contain" loading="lazy" />
        </li>
      ))}
    </ul>
    <h2 id="evo-title" class="reveal mx-auto mt-14 md:mt-20 max-w-[22ch] text-center font-serif text-[32px] md:text-[44px] leading-[1.12] text-carbon">Connecting generations through what they make and remember.</h2>
    <div class="mx-auto mt-10 grid max-w-[900px] gap-8 md:grid-cols-3 text-[16px] leading-relaxed text-[#6B6660] max-md:text-center">
      <p class="reveal">Keep voice notes, photos, songs, films and documents in one private place, organised and easy to find.</p>
      <p class="reveal">Every piece stays credited to the person who made or shared it, wherever it travels.</p>
      <p class="reveal">Pass it on to family, collaborators and the next generation, so nothing important is lost.</p>
    </div>
  </section>

  <!-- Moods: slow cross-fading textures with a glass label -->
  <section class="bg-white px-3 md:px-10 py-20 md:py-28" aria-labelledby="moods-title">
    <h2 id="moods-title" class="reveal ws-h mx-auto mb-10 md:mb-14 max-w-[16ch] text-center text-[clamp(38px,6vw,72px)]">Whatever you make, Auvra keeps it.</h2>
    <div class="moods mx-auto max-w-[1240px]" aria-hidden="true">
      {['Stories', 'Music', 'Languages', 'Film', 'Family', 'Art', 'Recipes', 'Voices', 'Memories'].map((label, i) => (
        <div class="mood" style={`--i:${i}`}>
          <img src={`/images/moods/mood-${i}.webp`} alt="" loading="lazy" />
          <span class="mood__pill">{label}</span>
        </div>
      ))}
    </div>
    <p class="sr-only">Auvra keeps stories, music, languages, film, family recordings, art, recipes, voices and memories.</p>
  </section>

  <!-- Statement: words and rugs interleaved, laid out like the reference poster -->
  <section class="bg-white px-5 py-20 md:py-32" aria-labelledby="statement-title">
    <h2 id="statement-title" class="sr-only">Your story isn't lost. It's preserved.</h2>
    <div class="rugs reveal" aria-hidden="true">
      <p class="rugs__t" style="left:1.6%;top:1.6%">Your<br />story</p>
      <img src="/images/rugs/lizard.webp" alt="" style="left:40.8%;top:3.1%;width:31.8%" loading="lazy" />
      <img src="/images/rugs/tiger-palms.webp" alt="" style="left:77.9%;top:2.4%;width:21.6%" loading="lazy" />
      <img src="/images/rugs/lemons.webp" alt="" style="left:1.6%;top:36.9%;width:41.1%" loading="lazy" />
