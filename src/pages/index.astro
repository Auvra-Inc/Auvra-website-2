---
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import Icon3D from '../components/Icon3D.astro';
import { HOME_FAQS, GALLERY, RIBBON, MOVEMENT, DRIFT } from '../data/site.js';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const preserve = ['Oral histories', 'Languages', 'Recipes', 'Rituals', 'Crafts', 'Songs', 'Family memories'];
const partners = [
  { name: 'Paystack', src: '/images/partners/paystack.png', w: 600, h: 106 },
  { name: 'Dojah', src: '/images/partners/dojah.svg', w: 67, h: 30 },
  { name: 'ElevenLabs', src: '/images/partners/elevenlabs.svg', w: 694, h: 90 },
  { name: 'NVIDIA Inception Program', src: '/images/partners/nvidia.png', w: 267, h: 94 },
];
const driftRows = [0, 1, 2, 3, 4, 5].map((r) => [...DRIFT.slice(r * 2), ...DRIFT.slice(0, r * 2)]);
---
<Base jsonld={[faqLd]} bodyClass="home">
  <!-- 2 · Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__halo" aria-hidden="true"></div>
    <div class="ribbon" aria-hidden="true" data-pause-offscreen>
      <div class="ribbon__ring" style={`--n:${RIBBON.length}`}>
        {RIBBON.map((ph, i) => (
          <div class="ribbon__card" style={`--i:${i}`}><img src={ph.thumb} alt="" width="240" height="320" decoding="async" fetchpriority={i < 3 ? 'high' : 'low'} /></div>
        ))}
      </div>
    </div>
    <div class="hero__content wrap">
      <p class="kicker-pill"><span aria-hidden="true">✦</span> The permanent home for human culture</p>
      <h1 id="hero-title" class="mega">
        <span class="line">Your story.</span>
        <span class="line">Your culture.</span>
        <span class="line">Your <em class="hl">legacy.</em></span>
      </h1>
      <p class="hero__sub">Record the stories, languages and traditions that make you who you are. Lens AI transcribes and translates them, and your family keeps them for generations.</p>
      <StoreButtons />
    </div>
  </section>

  <!-- 3 · App preview stage -->
  <section class="stage wrap" aria-label="A look inside the Auvra app">
    <div class="stage__inner">
      <div class="phone" role="img" aria-label="The Auvra app showing a family story transcribed by Lens AI">
        <div class="phone__notch"></div>
        <div class="phone__screen">
          <div class="app-top"><span>9:41</span><span class="app-top__icons">●●●</span></div>
          <div class="app-photo"><img src="/images/photos/hands-braid-480.webp" alt="" width="480" height="320" loading="lazy" /><span class="chip chip--blue">✦ Transcribed by Lens AI</span></div>
          <h3 class="app-title">How our family began</h3>
          <p class="app-meta">Told by Grandma Nneoma · Igbo · 2:14</p>
          <div class="player">
            <span class="player__btn" aria-hidden="true">▶</span>
            <span class="wave" aria-hidden="true">{Array.from({ length: 28 }).map((_, i) => <i style={`--h:${20 + ((i * 37) % 70)}%`}></i>)}</span>
            <span class="player__time">0:48</span>
          </div>
          <div class="transcript">
            <small>Transcript</small>
            <p>“Our great-grandfather came from Nnewi with nothing but a hoe and a song…”</p>
          </div>
          <div class="app-tabs" aria-hidden="true"><span class="on">Vault</span><span>Lens AI</span><span>Community</span></div>
        </div>
      </div>

      <div class="float-card fc1" aria-hidden="true">
        <div class="fc-row"><span class="dot dot--salmon">🎙</span><div><b>Voice note</b><small>Recorded today</small></div></div>
        <span class="wave wave--sm">{Array.from({ length: 22 }).map((_, i) => <i style={`--h:${25 + ((i * 53) % 70)}%`}></i>)}</span>
      </div>
      <div class="float-card fc2" aria-hidden="true">
        <div class="fc-row"><span class="dot dot--blue">✦</span><b>Lens AI · Translation</b></div>
        <p class="tr"><small>Igbo</small>Nna nna anyi si Nnewi bia</p>
        <p class="tr"><small>English</small>Our great-grandfather came from Nnewi</p>
      </div>
      <div class="float-card fc3" aria-hidden="true">
        <b>Okafor Family Vault</b>
        <small>Private · 4 members</small>
        <span class="avatars"><img src="/images/photos/elder-480.webp" alt="" loading="lazy" /><img src="/images/photos/beadwork-480.webp" alt="" loading="lazy" /><img src="/images/photos/young-man-480.webp" alt="" loading="lazy" /><img src="/images/photos/gele-480.webp" alt="" loading="lazy" /></span>
      </div>
      <div class="float-card fc4" aria-hidden="true">
        <div class="fc-row"><span class="dot dot--lime">✓</span><b>Preserved</b></div>
        <small>Credited to Grandma Nneoma</small>
        <small>A permanent family record</small>
      </div>
    </div>
  </section>

  <!-- 4 · Partners -->
  <section class="partners" aria-labelledby="partners-title">
    <h2 id="partners-title" class="partners__title">Our partners in innovation</h2>
    <div class="marquee marquee--partners" data-pause-offscreen>
      <div class="marquee__track">
        {[0, 1].map((copy) => (
          <ul class="marquee__group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {partners.map((pt) => (
              <li class="partner"><img src={pt.src} alt={copy === 0 ? pt.name : ''} width={pt.w} height={pt.h} loading="lazy" /></li>
            ))}
            {partners.map((pt) => (
              <li class="partner" aria-hidden="true"><img src={pt.src} alt="" width={pt.w} height={pt.h} loading="lazy" /></li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- 5 · What we preserve -->
  <section class="preserve" aria-label="What we preserve">
    <div class="preserve__band">
      <p class="sr-only">We preserve {preserve.join(', ')}.</p>
      <div class="marquee marquee--preserve" aria-hidden="true" data-pause-offscreen>
        <div class="marquee__track">
          {[0, 1].map(() => (
            <div class="marquee__group">{[...preserve, ...preserve].map((w) => <span class="preserve__item">{w}<span class="star">✦</span></span>)}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · Intro + 3 steps -->
  <section class="intro wrap section" aria-labelledby="intro-title">
    <h2 id="intro-title" class="h2 reveal">The cultural preservation platform <span class="hl-bg">built for you</span></h2>
    <p class="lead reveal">Auvra is the AI-powered home where families, creators and communities preserve what matters, so it is never lost and always credited to the people who carry it.</p>
    <ol class="steps3 reveal">
      <li><Icon3D name="mic" size={44} /><span><b>1</b> Record a memory</span></li>
      <li><Icon3D name="sparkle" size={44} /><span><b>2</b> Lens AI understands it</span></li>
      <li><Icon3D name="gift" size={44} /><span><b>3</b> Pass it down forever</span></li>
    </ol>
  </section>

  <!-- 7 · Bento -->
  <section class="wrap section bento-wrap" id="features" aria-labelledby="features-title">
    <p class="kicker reveal">Product features</p>
    <h2 id="features-title" class="h2 reveal">What you need to know about Auvra</h2>
    <div class="bento">
      <article class="tile tile--carbon t-vault reveal">
        <Icon3D name="vault" size={96} class="tile__icon" />
        <p class="tile__label">My Vault</p>
        <h3>A private home for your family's memories</h3>
        <p>Voice notes, photos, videos and documents, organised and shared only with the people you invite.</p>
        <ul class="chips"><li>Voice notes</li><li>Photos</li><li>Documents</li><li>Family invites</li></ul>
      </article>
      <article class="tile tile--blue t-lens reveal" id="lens-ai">
        <Icon3D name="sparkle" size={88} class="tile__icon" />
        <p class="tile__label">Lens AI</p>
        <h3>AI that understands culture</h3>
        <p>Transcribes and translates oral histories, tags cultural items and makes archives searchable.</p>
        <p class="tile__big">Igbo → English</p>
      </article>
      <article class="tile tile--gold reveal">
        <Icon3D name="shield" size={80} class="tile__icon" />
        <p class="tile__label">Contribution Badges</p>
        <h3>Shared knowledge, permanently credited</h3>
        <p>Communities add memories and context to a record without ever changing the original.</p>
      </article>
      <article class="tile tile--lime reveal">
        <Icon3D name="group" size={80} class="tile__icon" />
        <p class="tile__label">Communities</p>
        <h3>A home for your town or cultural group</h3>
        <p>Hometown unions, associations and cultural groups preserve their heritage together.</p>
      </article>
      <article class="tile tile--salmon reveal">
        <Icon3D name="passport" size={80} class="tile__icon" />
        <p class="tile__label">Auvra Passport</p>
        <h3>Your record of everything you preserve</h3>
        <p>Your profile links you to your records and contributions, so your credit always follows you.</p>
      </article>
    </div>
  </section>

  <!-- 8 · Manifesto -->
  <section class="manifesto pattern-bg" aria-labelledby="manifesto-title">
    <div class="wrap manifesto__inner">
      <h2 id="manifesto-title" class="serif-xl reveal">Because culture is worth more than <span class="muted">a scroll on someone's feed.</span></h2>
      <p class="reveal">Every day, stories are told at family gatherings, in village squares and on voice notes, and then they disappear. When an elder passes, a library goes with them. Auvra gives that knowledge a calm, permanent home, owned by the people who carry it.</p>
      <a class="btn btn--linen reveal" href="#get-started">Start preserving</a>
    </div>
  </section>

  <!-- 9 · Gallery -->
  <section class="gallery section" aria-labelledby="gallery-title">
    <div class="wrap gallery__inner">
      <div class="gallery__text">
        <h2 id="gallery-title" class="serif-xl">Not caged. <em class="blue">But lived.</em></h2>
        <p class="gallery__hint"><span aria-hidden="true">👆</span> Touch to change photo</p>
      </div>
      <div class="gallery__stage">
        <button class="deck" type="button" data-deck aria-label={`Show next photo, 1 of ${GALLERY.length}`} aria-describedby="deck-caption">
          {GALLERY.map((ph, i) => (
            <figure class="deck__card" data-index={i} data-pos={Math.min(i, 3)} style={`--pos:${Math.min(i, 3)}`}>
              <img src={ph.src} srcset={`${ph.thumb} 480w, ${ph.src} 960w`} sizes="(max-width: 760px) 80vw, 420px" alt={ph.alt} width="960" height="1280" loading="lazy" />
            </figure>
          ))}
        </button>
        <p class="deck__caption" id="deck-caption" aria-live="polite" data-deck-caption>
          <b>{GALLERY[0].caption}</b> · {GALLERY[0].place} · <span>{GALLERY[0].credit}</span>
        </p>
        <script type="application/json" data-deck-data set:html={JSON.stringify(GALLERY.map(({ caption, place, credit }) => ({ caption, place, credit })))} />
      </div>
    </div>
  </section>

  <!-- 10 · Feature rows -->
  <section class="wrap section rows" aria-labelledby="rows-title">
    <p class="kicker reveal">Built for preservation</p>
    <h2 id="rows-title" class="h2 reveal">Everything you need to keep culture alive</h2>

    <article class="row">
      <div class="row__text reveal">
        <Icon3D name="speech" size={64} />
        <p class="tile__label">Lens AI</p>
        <h3>Speak in your language. Lens AI does the rest.</h3>
        <p>Lens AI transcribes and translates oral histories, tags cultural items and makes archives searchable, starting with African languages.</p>
        <ul class="ticks">
          <li>Transcription of elders' voice notes</li>
          <li>Translation between African languages, English and French</li>
          <li>Tags for people, places and traditions</li>
          <li>You can always review and edit what it writes</li>
        </ul>
      </div>
      <div class="row__panel slide-in" style="--tint:#ECE8FF">
        <div class="screen chat" role="img" aria-label="Lens AI chat transcribing and translating a recording">
          <p class="screen__head"><span class="dot dot--blue">✦</span> Lens AI</p>
          <p class="bubble bubble--me">Transcribe Grandpa's recording and translate it to English.</p>
          <p class="bubble bubble--ai">Done. Here is the transcript and the English translation. I tagged it <b>Family history</b> and <b>Nnewi</b>, and found 2 related recordings.</p>
          <div class="chips chips--light"><span>View transcript</span><span>Translate to French</span><span>Open related</span></div>
        </div>
      </div>
    </article>

    <article class="row row--flip" id="my-vault">
      <div class="row__text reveal">
        <Icon3D name="vault" size={64} />
        <p class="tile__label">My Vault</p>
        <h3>Your family's memories, kept together.</h3>
        <p>Create a private Vault, invite your family with a code, and keep voices, photos and documents in one safe place.</p>
        <ul class="ticks">
          <li>Invite family with a code; they join free</li>
          <li>Private by default, shared only with people you invite</li>
          <li>Every memory credited to the person who shared it</li>
        </ul>
      </div>
      <div class="row__panel slide-in" style="--tint:#FFF4D6">
        <div class="screen vault" role="img" aria-label="The Okafor Family Vault with a voice memory, wedding photos and handwritten recipes">
          <div class="screen__head screen__head--split"><span><b>Okafor Family Vault</b><small>Private · 4 members</small></span><span class="invite">+ Invite</span></div>
          <ul class="vault__list">
            <li><span class="vthumb vthumb--salmon">🎙</span><span><b>How our family began</b><small>Voice memory · Grandma Nneoma</small></span></li>
            <li><img class="vthumb" src="/images/photos/gele-480.webp" alt="" loading="lazy" /><span><b>Wedding photos, 1974</b><small>24 photos · Uncle Emeka</small></span></li>
            <li><span class="vthumb vthumb--gold">📜</span><span><b>Mama's handwritten recipes</b><small>Documents · Ada</small></span></li>
          </ul>
        </div>
      </div>
    </article>

    <article class="row" id="communities">
      <div class="row__text reveal">
        <Icon3D name="group" size={64} />
        <p class="tile__label">Communities</p>
        <h3>A permanent archive for your people.</h3>
        <p>Hometown unions, cultural associations and groups preserve their history together, with every contribution credited.</p>
        <ul class="ticks">
          <li>Register your town, union or group as a community</li>
          <li>Members add memories under the original record</li>
          <li>Sacred knowledge stays with its community</li>
        </ul>
      </div>
      <div class="row__panel slide-in" style="--tint:#E8F1E4">
        <div class="screen community" role="img" aria-label="The Igbo-Ukwu Heritage Circle community page with a record on bronze casting">
          <div class="community__cover"><img src="/images/photos/sculpture-480.webp" alt="" loading="lazy" /></div>
          <p class="screen__head"><b>Igbo-Ukwu Heritage Circle</b></p>
          <div class="record">
            <b>Bronze casting</b>
            <small>Told by Chidi Okeke</small>
            <div class="record__tags"><span class="tag tag--dark">Original record</span><span class="tag">3 contributions added</span></div>
          </div>
        </div>
      </div>
    </article>
  </section>

  <!-- 11 · How it works -->
  <section class="how section" aria-labelledby="how-title" id="get-started">
    <div class="wrap">
      <p class="kicker reveal">How it works</p>
      <h2 id="how-title" class="h2 reveal">Simple steps to get you started</h2>
      <ol class="how__grid">
        <li class="how__card reveal"><span class="how__n">01</span><Icon3D name="phone" size={88} /><h3>Download Auvra</h3><p>Create your free account in seconds on iPhone or Android.</p></li>
        <li class="how__card reveal"><span class="how__n">02</span><Icon3D name="house" size={88} /><h3>Start your Vault</h3><p>Make a family Vault or join your community, then invite the people who matter.</p></li>
        <li class="how__card reveal"><span class="how__n">03</span><Icon3D name="mic" size={88} /><h3>Record and upload</h3><p>Add voice notes, photos and documents. Lens AI transcribes and translates them.</p></li>
        <li class="how__card how__card--carbon reveal"><span class="how__n">04</span><Icon3D name="gift" size={88} /><h3>Pass it down</h3><p>Your culture is preserved, credited to you, and ready for the next generation.</p></li>
      </ol>
    </div>
  </section>

  <!-- 12 · FAQs -->
  <section class="wrap section faq-sec" aria-labelledby="faq-title">
    <div class="faq-sec__head">
      <p class="kicker reveal">FAQs</p>
      <h2 id="faq-title" class="h2 reveal">Got questions? Here are some answers</h2>
      <div class="faq-sec__btns reveal">
        <a class="btn btn--dark" href="/faqs">See all FAQs →</a>
        <a class="btn btn--ghost" href="/contact">Contact us</a>
      </div>
    </div>
    <div class="faq" data-faq>
      {HOME_FAQS.map((f, i) => (
        <div class="faq__item">
          <h3>
            <button type="button" class="faq__q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>
              {f.q}<span class="faq__icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="faq__a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} data-open={i === 0 ? 'true' : 'false'}>
            <div><p>{f.a}</p></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 13 · Movement -->
  <section class="wrap section movement" aria-labelledby="movement-title">
    <h2 id="movement-title" class="h2 reveal">More than a platform. <span class="hl-bg">A movement.</span></h2>
    <p class="lead reveal">Auvra is building a community of families, storytellers, creators and cultural keepers who believe culture deserves a permanent home. Join early and help shape it.</p>
    <ul class="movement__strip">
      {MOVEMENT.map((ph) => <li class="reveal"><img src={ph.src} srcset={`${ph.thumb} 480w, ${ph.src} 960w`} sizes="(max-width: 760px) 45vw, 230px" alt={ph.alt} width="480" height="720" loading="lazy" /></li>)}
    </ul>
  </section>

  <!-- 14 · Final CTA -->
  <section class="wrap cta-wrap" aria-labelledby="cta-title">
    <div class="cta">
      <div class="drift" aria-hidden="true" data-pause-offscreen>
        <div class="drift__grid">
          {[0, 1].map(() => driftRows.map((row) => (
            <div class="drift__row">{[...row, ...row].map((src) => <img src={src} alt="" width="200" height="260" loading="lazy" />)}</div>
          )))}
        </div>
      </div>
      <div class="cta__shade" aria-hidden="true"></div>
      <div class="cta__content">
        <h2 id="cta-title" class="h2">What we keep today, tomorrow remembers.</h2>
        <p>Start preserving your family's story today. It's free to begin.</p>
        <StoreButtons variant="light" />
        <form class="subscribe" data-subscribe novalidate>
          <label for="sub-email" class="sr-only">Your email for updates</label>
          <input id="sub-email" name="email" type="email" autocomplete="email" placeholder="Your email for updates" required />
          <button type="submit" class="btn btn--lemon">Get updates</button>
          <p class="subscribe__msg" role="status" aria-live="polite" data-subscribe-msg></p>
        </form>
      </div>
    </div>
  </section>
</Base>
