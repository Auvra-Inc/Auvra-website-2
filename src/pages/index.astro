---
// Homepage, laid out like wysemarket.com: hero → dark intro with three tiles → product features →
// poster statement → how it works carousel → dark FAQ + movement strip → gradient CTA footer.
import Base from '../layouts/Base.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Icon3D from '../components/Icon3D.jsx';
import Carousel from '../components/Carousel.jsx';
import Faq from '../components/Faq.jsx';
import { MOVEMENT, EXPLORE_HREF } from '../data/site.js';
import { DEFINITIONS } from '../data/definitions.js';
import { FAQ_GROUPS } from '../data/faqs.js';

const homeFaqs = [
  FAQ_GROUPS[0].items[0], // What is Auvra?
  FAQ_GROUPS[0].items[1], // What problem is Auvra solving?
  FAQ_GROUPS[2].items[0], // What is a Contribution Badge?
  FAQ_GROUPS[4].items[0], // What is My Vault?
  FAQ_GROUPS[5].items[0], // What is Lens AI?
  FAQ_GROUPS[0].items[2], // Who is Auvra building for?
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const tiles = [
  { label: 'Record a memory', icon: 'mic', bg: 'radial-gradient(circle at 50% 45%, #FFFFFF 0%, #E9DDFB 45%, #CDB8F0 100%)', strip: '#DCCBF7' },
  { label: 'Lens AI understands it', icon: 'sparkle', bg: 'radial-gradient(circle at 50% 45%, #FFFFFF 0%, #FFE3D6 45%, #FFC2AE 100%)', strip: '#FFD8C8' },
  { label: 'Pass it down forever', icon: 'gift', bg: 'radial-gradient(circle at 50% 45%, #FFFFFF 0%, #E2F0D6 45%, #C3DFAA 100%)', strip: '#D6EAC4' },
];
const features = [
  { icon: 'globe', tint: '#E0EEEF', name: 'Cultural Preservation', text: DEFINITIONS.culturalPreservation.short, href: '/cultural-preservation' },
  { icon: 'shield', tint: '#FFE9E3', name: 'Contribution Badges', text: DEFINITIONS.contributionBadges.short, href: '/contribution-badges' },
  { icon: 'gift', tint: '#ECE8FF', name: 'Collectible Badges', text: DEFINITIONS.collectibleBadges.short, href: '/collectible-badges' },
  { icon: 'vault', tint: '#E8F1E4', name: 'My Vault', text: DEFINITIONS.myVault.short, href: '/my-vault' },
  { icon: 'passport', tint: '#F4F0E8', name: 'Auvra Passport', text: DEFINITIONS.auvraPassport.short, href: '/auvra-passport' },
  { icon: 'speech', tint: '#ECE8FF', name: 'Lens AI & A-Chronos', text: 'AI that transcribes and translates oral histories, tags cultural items and makes archives searchable, and research towards AI that understands cultural context.', href: '/lens-ai' },
];
const steps = [
  { n: 1, title: 'Download Auvra', text: 'Create your free Auvra account in seconds on iPhone or Android.', bg: '#024B50', chip: '#0B6A70', accent: '#BCE784' },
  { n: 2, title: 'Start your Vault', text: 'Make a family Vault or join your community, then invite the people who matter.', bg: '#4A281C', chip: '#6D4435', accent: '#FF8F77' },
  { n: 3, title: 'Record and upload', text: 'Add voice notes, photos and documents. Lens AI transcribes and translates them.', bg: '#3310BE', chip: '#5A3BE0', accent: '#DCD5FF' },
  { n: 4, title: 'Pass it down', text: 'Your culture is preserved, credited to you, and ready for the next generation.', bg: '#E2583F', chip: '#F07B64', accent: '#FFF4D6' },
];
const audiences = [
  { id: 'families', name: 'Families' }, { id: 'creators', name: 'Creators' }, { id: 'communities', name: 'Communities' },
  { id: 'diaspora', name: 'Diaspora' }, { id: 'institutions', name: 'Museums & Institutions' },
];
---
<Base
  title="Auvra · Your story. Your culture. Your legacy."
  description="Auvra is a cultural technology company building the permanent home for human culture: infrastructure to preserve, own and pass down cultural heritage and traditions across generations."
  jsonld={[faqLd]}
>
  <!-- 1 · Hero -->
  <section id="home" class="flex flex-col bg-[#E1E1E9]" aria-labelledby="hero-title">
    <div class="relative flex flex-col overflow-hidden px-3 md:px-[3.25rem] pt-36 md:pt-40 pb-20 md:pb-[5.4rem] md:min-h-[756px]">
      <img src="/images/hero-temple-900.webp" alt="" aria-hidden="true" class="pointer-events-none absolute left-1/2 top-1/2 z-0 h-[112%] w-auto max-w-none -translate-x-1/2 -translate-y-1/2 select-none [mask-image:radial-gradient(closest-side,black_72%,transparent_100%)]" fetchpriority="high" />
      <div class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(ellipse_at_center,rgba(225,225,233,0.55)_0%,rgba(225,225,233,0.15)_55%,rgba(225,225,233,0)_75%)]" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto mt-auto flex max-w-[1240px] flex-col items-center gap-12 md:gap-8 text-center">
        <h1 id="hero-title" class="ws-h text-carbon !leading-[0.84] text-[19.5vw] md:text-[clamp(64px,8.8vw,128px)] md:!leading-[0.88]">
          {['Your story.', 'Your culture.', 'Your legacy.'].map((line) => (
            <span class="block md:whitespace-nowrap">{line.split(' ').map((w, i) => <>{i > 0 && ' '}<span class="hero-word block md:inline">{w}</span></>)}</span>
          ))}
        </h1>
        <p class="max-w-sm md:max-w-md text-[15px] md:text-xl font-medium leading-relaxed text-[#272727]">Record the stories, languages and traditions that make you who you are. Lens AI transcribes and translates them, and your family keeps them for generations.</p>
      </div>
    </div>
    <div class="relative isolate grid h-[640px] md:h-[732px] grid-cols-1 md:grid-cols-2 overflow-x-clip">
      <img src="/images/photos/joy-sky-1600.webp" srcset="/images/photos/joy-sky-960.webp 960w, /images/photos/joy-sky-1600.webp 1600w" sizes="(max-width: 767px) 100vw, 50vw" alt="A young woman laughing with her arms open under a blue sky" class="h-full w-full object-cover object-[60%_30%]" fetchpriority="high" />
      <img src="/images/photos/joy-sea-1600.webp" srcset="/images/photos/joy-sea-960.webp 960w, /images/photos/joy-sea-1600.webp 1600w" sizes="50vw" alt="A woman sitting on a sea wall on a sunny day, laughing" class="hidden md:block h-full w-full object-cover" loading="lazy" />
      <div class="hidden lg:block absolute left-[3.5%] top-[35%] z-10 w-[380px] rounded-[24px] bg-white/50 p-2">
        <div class="rounded-[18px] bg-white p-5 shadow-xl text-left">
          <div class="flex items-center gap-3"><img src="/images/photos/gele-480.webp" alt="" class="h-11 w-11 rounded-xl object-cover" /><p class="text-[16px] font-semibold leading-tight">Okafor Family Vault</p></div>
          <ul class="mt-4 space-y-2.5 text-[14px]">
            <li class="flex items-center justify-between"><span class="flex items-center gap-2"><img src="/images/photos/elder-480.webp" alt="" class="h-6 w-6 rounded-full object-cover" />Grandma Nneoma</span><span class="text-grey">12 memories</span></li>
            <li class="flex items-center justify-between"><span class="flex items-center gap-2"><img src="/images/photos/young-man-480.webp" alt="" class="h-6 w-6 rounded-full object-cover" />Chidi</span><span class="text-grey">5 memories</span></li>
          </ul>
          <p class="mt-4 border-t border-line pt-3 text-[13px] text-grey">Private · shared by invitation</p>
        </div>
      </div>
      <div class="absolute left-1/2 top-1/2 z-10 w-[78%] md:max-w-[440px] -translate-x-1/2 -translate-y-1/2 rounded-2xl md:rounded-[24px] bg-white/50 p-2">
        <div class="rounded-[18px] bg-white p-5 shadow-2xl">
          <div class="flex items-center gap-3">
            <img src="/images/photos/hands-braid-480.webp" alt="" class="h-12 w-12 rounded-xl object-cover" />
            <div class="text-left"><p class="text-[16px] md:text-[17px] font-semibold leading-tight">How our family began</p><p class="text-[13px] text-grey">Told by Grandma Nneoma · Igbo · 2:14</p></div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 text-center text-[15px] font-medium">
            <span class="rounded-xl bg-[#E8F1E4] py-2.5 text-[#2F6B12]">▶ Listen</span>
            <span class="rounded-xl bg-[#ECE8FF] py-2.5 text-blue">Translate</span>
          </div>
          <p class="mt-3 text-center text-[12px] text-grey">Igbo → English · Transcribed by Lens AI</p>
        </div>
      </div>
      <div class="hidden lg:block absolute right-[3.5%] top-1/2 z-10 w-[380px] rounded-[24px] bg-white/50 p-2">
        <div class="rounded-[18px] bg-white p-5 shadow-xl text-left">
          <p class="flex items-center gap-2 text-[14px] font-semibold text-blue">✦ Lens AI · Translation</p>
          <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-grey">Igbo</p>
          <p class="font-serif text-[17px] leading-snug">Nna nna anyị si Nnewi bịa</p>
          <p class="mt-2 text-[11px] font-semibold uppercase tracking-wider text-grey">English</p>
          <p class="font-serif text-[17px] leading-snug">Our great-grandfather came from Nnewi</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · Dark intro + three tiles -->
  <section class="flex flex-col items-center gap-y-[7.5rem] bg-[#191717] pt-[4.4rem] md:pt-[8.75rem]" aria-labelledby="intro-title">
    <div class="reveal flex max-w-[820px] flex-col items-center gap-8 md:gap-[3.25rem] px-10 text-center">
      <h2 id="intro-title" class="ws-h text-[#FBF8F1] text-[2.5rem] leading-[2.1rem] md:text-[3.75rem] md:leading-[3.4rem]">The cultural preservation platform built for you</h2>
      <p class="max-w-[600px] text-sm md:text-lg md:leading-7 text-[#888]">Auvra is the home where families, creators and communities preserve the stories, languages and traditions that matter, so they are never lost and always credited to the people who carry them.</p>
    </div>
    <ul class="grid w-full grid-cols-1 md:grid-cols-3 md:divide-x md:divide-[#2B2B2B]">
      {tiles.map((t) => (
        <li class="flex h-[516px] md:h-[645px] flex-col">
          <div class="relative flex flex-1 items-center justify-center" style={`background:${t.bg}`}>
            <Icon3D name={t.icon} size={230} />
            <p class="absolute bottom-8 md:bottom-[3.4rem] text-lg text-[#191717]">{t.label}</p>
          </div>
          <div class="h-[30px]" style={`background:${t.strip}`}></div>
        </li>
      ))}
    </ul>
  </section>

  <!-- 3 · Product features -->
  <section id="features" class="mx-auto flex max-w-[1280px] flex-col max-lg:gap-y-24 bg-white py-16 md:pt-[4.6rem] md:pb-40 px-8 xl:px-12 scroll-mt-24" aria-labelledby="features-title">
    <div class="flex items-center justify-between gap-10">
      <div class="flex flex-col max-md:items-center max-md:text-center">
        <p class="mb-4 text-sm md:text-base uppercase text-[#272727]">Product features</p>
        <h2 id="features-title" class="reveal ws-h mb-10 lg:mb-[3.4rem] text-[2.35rem] leading-[2.1rem] md:text-[3rem] md:leading-[3.4rem] lg:text-[3.75rem]">What you need to know about Auvra</h2>
        <p class="reveal max-w-[300px] md:max-w-[600px] text-sm md:text-base lg:text-lg text-[#272727]">Preserve stories, languages and traditions as permanent, credited records. Lens AI transcribes and translates oral histories, tags cultural items and makes archives searchable.</p>
      </div>
      <div class="hidden md:block w-[300px] lg:w-[340px] flex-none -rotate-6">
        <PhoneFrame label="Lens AI in the Auvra app transcribing and translating a grandparent's recording">
          <div class="flex h-full flex-col gap-3 bg-white px-4 pt-[18%] text-carbon">
            <p class="flex items-center gap-2 text-[15px] font-semibold"><span class="grid h-7 w-7 place-items-center rounded-lg bg-blue text-white">✦</span>Lens AI</p>
            <p class="self-end rounded-2xl rounded-br-md bg-carbon px-3 py-2 text-[12px] text-white">Transcribe Grandpa's recording and translate it to English.</p>
            <p class="rounded-2xl rounded-bl-md bg-[#F2EFFF] px-3 py-2 text-[12px]">Done. Here is the transcript and the English translation. I tagged it <b class="text-blue">Family history</b> and <b class="text-blue">Nnewi</b>.</p>
            <div class="flex flex-wrap gap-1.5">{['View transcript', 'Translate to French'].map((c) => <span class="rounded-full border border-[#DCD5FF] px-2.5 py-1 text-[10px] font-medium text-blue">{c}</span>)}</div>
          </div>
        </PhoneFrame>
      </div>
    </div>
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-y-12 md:gap-x-5 lg:gap-y-[5.5rem] md:mt-20">
      {features.map((f) => (
        <li class="flex flex-col">
          <span class="grid size-12 lg:size-16 place-items-center rounded-xl" style={`background:${f.tint}`}><Icon3D name={f.icon} size={44} /></span>
          <div class="reveal">
            <h3 class="mt-6 lg:mt-8 mb-2 lg:mb-5 text-xl font-semibold text-[#252020]"><a href={f.href} class="hover:underline">{f.name}</a></h3>
            <p class="text-base text-[#626262]">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- 4 · Poster statement -->
  <section class="relative flex flex-col items-center justify-center px-6 pt-[4.9rem] pb-28 md:py-[13.5rem] text-center" style="background: radial-gradient(ellipse at 50% 45%, #FF7A59 0%, #FFB08F 22%, #FFE2CF 42%, #FFFFFF 66%)" aria-labelledby="poster-title">
    <div class="reveal flex flex-col items-center">
      <h2 id="poster-title" class="ws-h mb-[3.75rem] md:mb-[4.5rem] max-w-[820px] text-[3.4rem] leading-[3.5rem] sm:text-[5rem] sm:leading-[4.2rem] md:text-[6.25rem] md:leading-[5.5rem] lg:text-[7rem]">Because<br /> culture is worth more than a scroll</h2>
      <p class="mb-10 max-w-[379px] md:max-w-[573px] text-sm md:text-lg md:leading-7 text-[#272727]">Every day, stories are told at family gatherings, in village squares and on voice notes, and then they disappear. When an elder passes, a library goes with them. Auvra gives that knowledge a calm, permanent home, owned by the people who carry it.</p>
    </div>
    <a href={EXPLORE_HREF} class="btn btn--dark shimmer !min-h-[64px] !px-12">Explore Auvra</a>
  </section>

  <!-- 5 · How it works -->
  <section id="how-it-works" class="flex flex-col gap-y-14 md:flex-row md:gap-x-16 lg:gap-x-[6.9rem] overflow-hidden px-8 lg:pl-[5.5rem] pt-[3.75rem] md:pt-[6.25rem] pb-[3.6rem] md:pb-[10.5rem]" aria-labelledby="how-title">
    <div class="flex max-w-[480px] flex-none flex-col">
      <p class="mb-2.5 uppercase text-[#272727]">How it works</p>
      <h2 id="how-title" class="reveal ws-h mb-8 md:mb-14 text-[2.5rem] leading-[2.1rem] md:text-[3.75rem] md:leading-[3.4rem]">Simple steps to get you started</h2>
      <Carousel client:visible label="step" target="steps-track" />
    </div>
    <ol id="steps-track" class="snap-row !gap-2 py-5 md:py-10 pr-2" tabindex="0" aria-label="How Auvra works, step by step">
      {steps.map((s) => (
        <li class="flex h-[360px] md:h-[500px] lg:h-[624px] w-[260px] md:w-[380px] lg:w-[515px] flex-col justify-between rounded-2xl px-[1.4rem] md:px-10 pt-6 md:pt-12 pb-9 md:pb-20" style={`background:${s.bg}`}>
          <span class="grid size-11 md:size-20 place-items-center rounded-lg md:rounded-2xl text-xl md:text-3xl font-bold text-white" style={`background:${s.chip}`}>{s.n}</span>
          <div class="flex flex-col">
            <h3 class="text-xs md:text-lg lg:text-xl font-semibold uppercase leading-8 md:leading-[3.5rem]" style={`color:${s.accent}`}>{s.title}</h3>
            <p class="text-xl md:text-2xl lg:text-[1.75rem] lg:leading-[3rem] tracking-[-0.01em] text-white">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- 6 · Dark FAQ + movement -->
  <section id="faqs" class="flex flex-col gap-y-[11rem] md:gap-y-[14rem] lg:gap-y-[19rem] bg-[#191717] py-[3.75rem] md:pt-[6.5rem] md:pb-[10.5rem]" aria-labelledby="faq-title">
    <div class="flex flex-col items-center">
      <div class="mb-8 flex items-end" aria-hidden="true"><Icon3D name="speech" size={120} /><Icon3D name="sparkle" size={90} className="-ml-6" /></div>
      <h2 id="faq-title" class="reveal ws-h mb-[6.5rem] max-w-xs md:max-w-xl text-center text-[#FBF8F1] text-[2.75rem] leading-[2.75rem] sm:text-[3.4rem] md:text-[4rem] md:leading-[3.5rem] lg:text-[5.5rem] lg:leading-[4.4rem]">Got questions? Here are some answers</h2>
      <div class="ws-faq w-full max-w-[946px] px-8 md:px-4">
        <Faq client:visible items={homeFaqs} firstOpen={false} />
        <p class="mt-8 text-center"><a href="/faqs" class="inline-flex min-h-11 items-center text-[#FBF8F1] underline underline-offset-4">See all FAQs</a></p>
      </div>
    </div>
    <div id="community" class="flex flex-col items-center">
      <div class="reveal flex flex-col items-center">
        <h2 class="ws-h mb-8 md:mb-16 max-w-2xl text-center text-[#FBF8F1] text-[2.75rem] leading-[2.75rem] sm:text-[3.4rem] md:text-[4rem] md:leading-[3.5rem] lg:text-[5.5rem] lg:leading-[4.4rem]">More than a platform<br /> a movement</h2>
        <p class="mb-8 max-w-xs md:max-w-[698px] text-center text-sm md:text-lg leading-7 text-[#888]">Auvra is building a community of families, storytellers, creators and cultural keepers who believe culture deserves a permanent home. Join early and help shape it.</p>
        <ul class="mb-12 md:mb-24 flex max-w-xs md:max-w-none flex-wrap justify-center gap-2" aria-label="Who we serve">
          {audiences.map((a) => <li id={a.id} class="scroll-mt-28"><span class="inline-flex min-h-11 items-center rounded-full border border-[#3A3632] px-4 text-sm text-[#FBF8F1]">{a.name}</span></li>)}
        </ul>
      </div>
      <div class="marquee marquee--people w-full" data-pause-offscreen aria-hidden="true">
        <div class="marquee__track">
          {[0, 1].map(() => (
            <div class="marquee__group gap-2 md:gap-3.5 pr-2 md:pr-3.5">
              {[...MOVEMENT, ...MOVEMENT].map((ph) => <img src={ph.thumb} alt="" class="h-[184px] md:h-[368px] w-auto aspect-[2/3] rounded-xl md:rounded-3xl object-cover" loading="lazy" />)}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
