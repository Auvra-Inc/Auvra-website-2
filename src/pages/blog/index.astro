---
import Base from '../../layouts/Base.astro';
import { posts, formatDate } from '../../content/posts';
---
<Base title="Blog · Auvra" description="Stories and updates from Auvra on cultural preservation, African languages and Lens AI.">
  <section class="wrap page-hero">
    <p class="kicker">Blog</p>
    <h1 class="h2">Stories and updates</h1>
    <p class="lead">From cultural discoveries to preserved legacies on Auvra.</p>
  </section>
  <section class="wrap" style="padding-bottom:var(--sec)">
    {posts.length === 0 ? (
      <p class="lead">No articles published yet. Check back soon.</p>
    ) : (
      <ul class="card-grid post-list" role="list">
        {posts.map((post) => (
          <li class="card post-card">
            <a class="post-card__img" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true">
              <img src={post.thumb} alt="" width="480" height={Math.round((480 * post.imageHeight) / post.imageWidth)} loading="lazy" decoding="async" />
            </a>
            <h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            <p><time datetime={post.date}>{formatDate(post.date)}</time></p>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .post-list { list-style: none; padding: 0; }
  .post-card { position: relative; }
  .post-card__img { display: block; border-radius: 20px; overflow: hidden; aspect-ratio: 1; background: var(--line); margin-bottom: 8px; }
  .post-card__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .post-card:hover .post-card__img img { transform: scale(1.04); }
  .post-card h2 { font-size: 22px; font-weight: 600; letter-spacing: -.02em; line-height: 1.2; }
  .post-card h2 a { color: inherit; text-decoration: none; }
  .post-card h2 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .post-card h2 a:focus-visible { outline: none; }
  .post-card:focus-within { outline: 2px solid var(--blue); outline-offset: 3px; }
</style>
