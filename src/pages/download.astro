---
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { STORE } from '../data/site.js';
---
<Base title="Download Auvra" description="Get Auvra for iPhone and Android and start preserving your family's stories, languages and traditions.">
  <section class="wrap page-hero dl">
    <p class="kicker">Download</p>
    <h1 class="h2">{STORE.live ? 'Get Auvra on your phone' : 'Auvra is coming to your phone'}</h1>
    <p class="lead">{STORE.live
      ? 'Download Auvra for iPhone or Android, create your free account and start your family Vault.'
      : 'The Auvra app is launching soon on the App Store and Google Play. Leave your email below and we will tell you the moment it is live.'}</p>
    <StoreButtons />
    <form class="subscribe subscribe--light" data-subscribe novalidate>
      <label for="dl-email" class="sr-only">Your email for updates</label>
      <input id="dl-email" name="email" type="email" autocomplete="email" placeholder="Your email for updates" required />
      <button type="submit" class="btn btn--dark">Get updates</button>
      <p class="subscribe__msg" role="status" aria-live="polite" data-subscribe-msg></p>
    </form>
  </section>
</Base>
<style>
  .dl { display: flex; flex-direction: column; gap: 24px; padding-bottom: var(--sec); }
  .subscribe--light { justify-content: flex-start; }
  .subscribe--light input { background: #fff; color: var(--carbon); border-color: #D9D3C8; }
  .subscribe--light input::placeholder { color: var(--grey); }
  .subscribe--light .subscribe__msg[data-state='error'] { color: #B42E14; }
  .subscribe--light .subscribe__msg[data-state='success'] { color: #2F6B12; }
</style>
